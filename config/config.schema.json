{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://casedeck.local/schemas/config.schema.json",
  "title": "GroupConfig",
  "description": "Organization-level configuration: rate card, category mapping, confidence bands, currency default. Produced by the /setup skill or the in-app wizard. One file per organization/group.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orgName",
    "currency",
    "displayUnitsDefault",
    "loadedCostMultiplier",
    "confidenceBands",
    "categories",
    "statuses",
    "rateCard",
    "categoryMapping"
  ],
  "properties": {
    "orgName": { "type": "string", "minLength": 1 },
    "currency": {
      "type": "string",
      "description": "ISO 4217 currency code. Display-only — no FX conversion in v1.",
      "pattern": "^[A-Z]{3}$"
    },
    "displayUnitsDefault": { "type": "string", "enum": ["whole", "thousands"] },
    "loadedCostMultiplier": {
      "type": "number",
      "description": "Default multiplier applied by the engine to raw hours x rate for salary line items. Never pre-baked into the rate card.",
      "exclusiveMinimum": 0
    },
    "confidenceBands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["committed", "estimated", "rough"],
      "properties": {
        "committed": { "$ref": "#/$defs/confidenceBand" },
        "estimated": { "$ref": "#/$defs/confidenceBand" },
        "rough": { "$ref": "#/$defs/confidenceBand" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["planning", "ready_for_approval", "approved", "in_progress", "completed", "on_hold"]
          },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rateCard": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "ratePerHour"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "ratePerHour": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "categoryMapping": {
      "type": "array",
      "description": "Account code -> category. A category value of \"ignore\" excludes matching rows from import; codes absent from this list trigger the import preview's \"ask\" flow.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accountCode", "category"],
        "properties": {
          "accountCode": { "type": "string", "pattern": "^[0-9]+$" },
          "category": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "confidenceBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bandPct"],
      "properties": {
        "bandPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Symmetric band as a percentage. worst = costs +bandPct%, revenue -bandPct%; best = costs -bandPct%, revenue +bandPct%."
        }
      }
    }
  }
}
